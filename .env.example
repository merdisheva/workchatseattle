# Database - Neon PostgreSQL
DATABASE_URL="postgresql://username:password@hostname.neon.tech/workchatseattle?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here-generate-with-openssl-rand-base64-32"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Admin emails (comma-separated)
ADMIN_EMAILS="your-email@example.com"

# Vercel Blob - used to store event materials (slides, handouts, etc.)
# Provision a store with `vercel blob create-store` and pull with `vercel env pull`
BLOB_READ_WRITE_TOKEN=""
